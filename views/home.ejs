<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Ma ToDo List</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>
    <h1>Ma ToDo List</h1>

    <% if (message) { %>
        <p><%= message %></p>
    <% } %>

    <table>
        <thead>
            <tr>
                <th>Nom</th>
                <th>Deadline</th>
                <th>Priorité</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody>
            <% if (!todos || todos.length === 0) { %>
                <tr>
                    <td colspan="4">Aucune tâche</td>
                </tr>
            <% } %>

            <% if (todos && todos.length > 0) { %>
                <% todos.forEach((todo) => { %>
                    <% if (String(editId) === String(todo.id)) { %>
                        <tr>
                            <td colspan="4">
                                <h2>Modifier la tâche</h2>
                                <%- include('partials/todo-form', {
                                    formAction: `/modifier/${todo.id}`,
                                    submitLabel: 'Sauvegarder',
                                    values: {
                                        nom: todo.nom || '',
                                        deadline: todo.deadline || '',
                                        priorite: String(todo.priorite || '2')
                                    },
                                    labels,
                                    priorityOptions,
                                    formClass: 'todo-form'
                                }) %>
                                <p><a href="/">Annuler</a></p>
                            </td>
                        </tr>
                    <% } else { %>
                        <tr>
                            <td><%= todo.nom %></td>
                            <td><%= todo.deadline || '-' %></td>
                            <td><%= todo.priorite %></td>
                            <td>
                                <a href="/?edit=<%= todo.id %>">Modifier</a>
                                <form action="/supprimer/<%= todo.id %>" method="POST">
                                    <button type="submit">Supprimer</button>
                                </form>
                            </td>
                        </tr>
                    <% } %>
                <% }) %>
            <% } %>
        </tbody>
    </table>

    <section>
        <h2>Ajouter une tâche</h2>
        <%- include('partials/todo-form', {
            formAction: addForm.formAction,
            submitLabel: addForm.submitLabel,
            values: addForm.values,
            labels,
            priorityOptions,
            formClass: addForm.formClass
        }) %>
    </section>
</body>
</html>